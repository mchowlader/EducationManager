{
  "ConnectionStrings": {
    "MasterDBConnection": "Host=localhost;Port=5432;Database=EduManager_Master;Username=EduManager;Password=@EduManager682672@;",
    "DefaultTenantConnection": "Host=localhost;Port=5432;Database=EduManager_Template;Username=EduManager;Password=@EduManager682672@;"
  },
  "Jwt": {
    "Issuer": "EduManager",
    "Audience": "EduManager"
